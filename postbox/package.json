{
  "name": "postbox",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf ./dist",
    "build-types": "tsc --declaration --emitDeclarationOnly --outDir ./dist",
    "build-lib": "vite build",
    "build": "npm run clean && npm run build-lib && npm run build-types",
    "npm-clean": "npm run clean && rm -rf node_modules dist package-lock.json && npm run clean && npm uninstall @types/node typescript vite && npm i -D @types/node typescript vite"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/postbox.es.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/postbox.umd.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/postbox.umd.js",
  "module": "./dist/postbox.es.js",
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.16"
  }
}
