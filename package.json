{
  "name": "introduction-to-microfrontends",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "pretty": "prettier --config .prettierrc --loglevel warn -w \"./**/*.*{ts,vue,svelte,tsx,css,scss,html}\"",
    "build": "nx run-many -t build --parallel=4",
    "serve": "nx run-many -t watch-and-run --parallel --output-style=stream",
    "affected:build": "nx affected -t build",
    "graph": "nx graph"
  },
  "devDependencies": {
    "nx": "^22.7.8",
    "pnpm": "^10.34.5"
  }
}
