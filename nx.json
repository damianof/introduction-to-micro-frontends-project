{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/node_modules/**",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.*",
      "!{projectRoot}/dist/**"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/package.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "serve": {
      "cache": false,
      "dependsOn": [
        "^build"
      ]
    },
    "watch-and-run": {
      "cache": false,
      "continuous": true,
      "dependsOn": [
        "^build"
      ]
    }
  },
  "nxCloudId": "",
  "analytics": false
}