{
  "name": "root-styles",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "npm run dev",
    "build-watch": "tsc && vite build --watch",
    "watch-and-run": "concurrently \"npm run build-watch\" \"npm start\"",
    "clean": "rm -rf dist",
    "npm-clean": "npm run clean && rm -rf node_modules dist package-lock.json && npm i -D @tailwindcss/vite @types/node tailwindcss typescript vite"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.16"
  }
}
